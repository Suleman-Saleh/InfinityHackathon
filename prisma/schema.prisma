generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  AGENT
}

enum RunStatus {
  SUCCESS
  INVALID
  FAILED
}

model User {
  id             String   @id // seeded reference codes: ADMIN, PM01..PM03, DEV01..DEV06
  name           String
  email          String   @unique
  passwordHash   String
  role           Role
  specialization String
  skills         String[]
  createdAt      DateTime @default(now())

  managedProjects Project[]       @relation("ProjectManager")
  tasks           Task[]          @relation("TaskAssignee")
  transcriptRuns  TranscriptRun[]
}

model Project {
  id              String   @id @default(cuid())
  name            String
  clientName      String
  description     String   @default("")
  managerId       String
  deadline        DateTime @db.Date
  transcriptRunId String?
  createdAt       DateTime @default(now())

  manager       User           @relation("ProjectManager", fields: [managerId], references: [id])
  transcriptRun TranscriptRun? @relation(fields: [transcriptRunId], references: [id], onDelete: SetNull)
  tasks         Task[]

  @@index([managerId])
}

model Task {
  id             String   @id @default(cuid())
  projectId      String
  title          String
  description    String   @default("")
  assigneeId     String
  deadline       DateTime @db.Date
  estimatedHours Float
  createdAt      DateTime @default(now())

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee User    @relation("TaskAssignee", fields: [assigneeId], references: [id])

  @@index([projectId])
  @@index([assigneeId])
}

// Audit log of every transcript conversion attempt (raw input + AI output).
model TranscriptRun {
  id          String    @id @default(cuid())
  createdById String
  transcript  String
  aiOutput    Json?
  model       String?
  status      RunStatus
  issues      String[]
  createdAt   DateTime  @default(now())

  createdBy User      @relation(fields: [createdById], references: [id])
  projects  Project[]
}
